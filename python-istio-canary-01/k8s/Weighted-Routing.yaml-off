# ... (Gateway and DestinationRule are unchanged) ...
---
apiVersion: networking.istio.io/v1alpha3
kind: VirtualService
metadata:
  name: python-app-vs
  namespace: istio-test
spec:
  hosts:
  - "*"
  gateways:
  - python-app-gateway
  http:
  - route:
    - destination:
        host: python-app-service
        subset: v1
      weight: 90 # Change
    - destination:
        host: python-app-service
        subset: v2
      weight: 10 # Change
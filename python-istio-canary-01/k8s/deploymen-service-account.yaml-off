apiVersion: v1
kind: Namespace
metadata:
  name: istio-test
  labels:
    istio-injection: enabled

---
# mTLS and identity: Istio uses the service account as the identity of the workload for mutual TLS and authorization.
# Istio authorization policies: You can write fine-grained policies allowing access only to workloads using a specific ServiceAccount.

apiVersion: v1
kind: ServiceAccount
metadata:
  name: python-app-sa
  namespace: istio-test

---

apiVersion: apps/v1
kind: Deployment
metadata:
  name: python-app-v1
  namespace: istio-test
spec:
  replicas: 1
  selector:
    matchLabels:
      app: python-app
      version: v1
  template:
    metadata:
      labels:
        app: python-app
        version: v1
    spec:
      serviceAccountName: python-app-sa  # <-- using the service account
      containers:
      - name: python-app
        image: m2s-registry.osl.team/tanvir-devops/my-python-app:v1
        imagePullPolicy: IfNotPresent
        ports:
        - containerPort: 5000
        env:
        - name: APP_VERSION
          value: "v1"
        - name: POD_NAME
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
      imagePullSecrets:
        - name: harbor-registry-secret

---

apiVersion: apps/v1
kind: Deployment
metadata:
  name: python-app-v2
  namespace: istio-test
spec:
  replicas: 1
  selector:
    matchLabels:
      app: python-app
      version: v2
  template:
    metadata:
      labels:
        app: python-app
        version: v2
    spec:
      serviceAccountName: python-app-sa  # <-- using the same service account
      containers:
      - name: python-app-v2
        image: m2s-registry.osl.team/tanvir-devops/my-python-app:v2
        imagePullPolicy: IfNotPresent
        ports:
        - containerPort: 5000
        env:
        - name: APP_VERSION
          value: "v2"
        - name: POD_NAME
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
      imagePullSecrets:
        - name: harbor-registry-secret

---

apiVersion: v1
kind: Service
metadata:
  name: python-app-service
  namespace: istio-test
spec:
  selector:
    app: python-app
  ports:
  - protocol: TCP
    port: 80
    targetPort: 5000
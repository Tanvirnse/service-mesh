# Allow only GET requests to /health from python-app-sa

apiVersion: security.istio.io/v1beta1
kind: AuthorizationPolicy
metadata:
  name: allow-health-check
  namespace: istio-test
spec:
  selector:
    matchLabels:
      app: python-app
  action: ALLOW
  rules:
  - from:
    - source:
        principals: ["cluster.local/ns/istio-test/sa/python-app-sa"]
    to:
    - operation:
        methods: ["GET"]
        paths: ["/health"]
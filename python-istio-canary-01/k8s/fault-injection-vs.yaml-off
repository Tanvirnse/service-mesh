# Simulate service failures or delays for testing.
# Introduces a 5-second delay on 100% of requests to v1.
# Helps test how upstream services handle latency.

apiVersion: networking.istio.io/v1alpha3
kind: VirtualService
metadata:
  name: python-app-fault
  namespace: istio-test
spec:
  hosts:
  - "exp8.osl.team"
  gateways:
  - python-app-gateway
  http:
  - fault:
      delay:
        percentage:
          value: 100.0
        fixedDelay: 5s
    route:
    - destination:
        host: python-app-service
        subset: v1

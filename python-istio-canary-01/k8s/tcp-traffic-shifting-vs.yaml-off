# For raw TCP services (not HTTP), e.g., databases.
# TCP traffic is split 90/10 between v1 and v2 of a TCP-based service (replace tcp-service with actual service name).
apiVersion: networking.istio.io/v1alpha3
kind: VirtualService
metadata:
  name: tcp-app
  namespace: istio-test
spec:
  hosts:
  - tcp-service
  tcp:
  - route:
    - destination:
        host: tcp-service
        subset: v1
      weight: 90
    - destination:
        host: tcp-service
        subset: v2
      weight: 10
